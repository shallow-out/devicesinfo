{
  "cgroup": "v2",
  "containers": [
    {
      "name": "docker",
      "path": "/usr/bin/docker",
      "sockets": [
        "/run/docker.sock",
        "/var/run/docker.sock"
      ]
    }
  ],
  "declared_tags": [
    {
      "source": "/etc/deviceinfo/tags.conf",
      "tag": "always-on"
    }
  ],
  "init": "systemd",
  "kernel_release": "6.18.18.c1090-trim",
  "operating_system": {
    "id": "debian",
    "name": "Debian GNU/Linux",
    "pretty_name": "Debian GNU/Linux 12 (bookworm)",
    "source": "/etc/os-release",
    "version_id": "12"
  },
  "package_managers": [
    "apt-get"
  ],
  "registry_mirrors": [
    {
      "source": "/etc/docker/daemon.json",
      "url": "https://docker.fnnas.com"
    },
    {
      "source": "/etc/docker/daemon.json",
      "url": "https://registry.hub.docker.com"
    }
  ],
  "warnings": []
}
