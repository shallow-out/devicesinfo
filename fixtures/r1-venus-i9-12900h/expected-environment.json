{
  "cgroup": "v2",
  "containers": [
    {
      "name": "docker",
      "notes": [
        "不是真的 docker：是个壳脚本，实际调用 podman"
      ],
      "path": "/usr/bin/docker"
    },
    {
      "name": "podman",
      "path": "/usr/bin/podman",
      "sockets": [
        "/run/user/1000/podman/podman.sock"
      ]
    }
  ],
  "declared_tags": [
    {
      "source": "/etc/deviceinfo/tags.conf",
      "tag": "always-on"
    }
  ],
  "init": "systemd",
  "kernel_release": "7.2.6-arch2-1",
  "operating_system": {
    "id": "arch",
    "name": "Arch Linux",
    "pretty_name": "Arch Linux",
    "source": "/etc/os-release"
  },
  "package_managers": [
    "pacman"
  ],
  "warnings": []
}
